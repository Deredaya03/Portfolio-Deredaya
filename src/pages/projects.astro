---
import Layout from '@layouts/Layout.astro';
import Viewer3D from '@components/Viewer3D.astro';
import CardProject from '@components/Index/cardProject.astro';
import PreFooter from '@components/Layout/PreFooter.astro';

import '@styles/project.css';
import '@styles/projects-page.css';

import { Data } from '@db/index.ts';

const projects = Array.isArray(Data.Projects)
  ? Data.Projects
  : [];

const availableProjects = projects.filter(
  (project) => project.link.trim().length > 0
);

const upcomingProjects = projects.filter(
  (project) => project.link.trim().length === 0
);
---

<Layout title="Proyectos | Deredaya">
  <!-- Modelo 3D de fondo -->
  <div class="projects-viewer">
    <Viewer3D />
  </div>

  <main class="projects-page">
    <!-- Espacio para el header fijo -->
    <div class="projects-page-space"></div>

    <!-- Hero -->
    <header class="projects-hero">
      <div class="projects-hero-content">
        <span
          class="projects-eyebrow"
          data-projects-reveal
        >
          Portafolio
        </span>

        <h1
          class="projects-page-title"
          data-projects-reveal
        >
          Proyectos
          <span>seleccionados</span>
        </h1>

        <p
          class="projects-page-description"
          data-projects-reveal
        >
          Una selección de sistemas, sitios web y herramientas
          desarrolladas para simplificar procesos, automatizar
          actividades y resolver necesidades reales.
        </p>
      </div>

      <div
        class="projects-summary"
        data-projects-reveal
      >
        <div class="projects-summary-item">
          <strong>
            {String(projects.length).padStart(2, '0')}
          </strong>

          <span>Proyectos</span>
        </div>

        <div class="projects-summary-item">
          <strong>
            {String(availableProjects.length).padStart(2, '0')}
          </strong>

          <span>Publicados</span>
        </div>

        <div class="projects-summary-item">
          <strong>
            {String(upcomingProjects.length).padStart(2, '0')}
          </strong>

          <span>En desarrollo</span>
        </div>
      </div>

      <div
        class="projects-scroll-hint"
        aria-hidden="true"
      >
        <span>Explorar</span>
        <span class="projects-scroll-arrow">↓</span>
      </div>
    </header>

    <!-- Proyectos -->
    <section
      class="projects-gallery"
      aria-labelledby="projects-gallery-title"
    >
      <header
        class="projects-gallery-header"
        data-projects-reveal
      >
        <div>
          <span class="projects-section-label">
            Trabajo reciente
          </span>

          <h2 id="projects-gallery-title">
            Todos los proyectos
          </h2>
        </div>

        <p>
          Cada proyecto fue desarrollado buscando equilibrio entre
          diseño, rendimiento, simplicidad y utilidad.
        </p>
      </header>

      {
        projects.length > 0 ? (
          <div class="projects-page-grid">
            {
              projects.map((project, index) => (
                <article
                  class="projects-page-item"
                  data-projects-card
                  style={`--project-position: ${index};`}
                >
                  <CardProject
                    card={project}
                    index={index}
                  />
                </article>
              ))
            }
          </div>
        ) : (
          <div class="projects-empty">
            <span>00</span>

            <h2>No hay proyectos disponibles</h2>

            <p>
              Los nuevos proyectos aparecerán aquí próximamente.
            </p>
          </div>
        )
      }
    </section>

    <!-- Publicados -->
    {
      availableProjects.length > 0 && (
        <section class="projects-available">
          <header
            class="projects-subsection-header"
            data-projects-reveal
          >
            <span class="projects-section-label">
              Disponibles
            </span>

            <h2>Proyectos publicados</h2>
          </header>

          <div class="projects-links">
            {
              availableProjects.map((project, index) => (
                <a
                  class="project-list-link"
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-projects-link
                >
                  <span class="project-list-number">
                    {String(index + 1).padStart(2, '0')}
                  </span>

                  <span class="project-list-name">
                    {project.title}
                  </span>

                  <span class="project-list-status">
                    Visitar
                  </span>

                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14"></path>
                    <path d="m13 6 6 6-6 6"></path>
                  </svg>
                </a>
              ))
            }
          </div>
        </section>
      )
    }

    <PreFooter />
  </main>

  <script>
    import '@scripts/projects-page.ts';
  </script>
</Layout>

<style>
  :root {
    color-scheme: dark;
  }

  .projects-viewer {
    position: fixed;
    inset: 0;
    z-index: 0;

    width: 100%;
    height: 100svh;

    pointer-events: none;
    overflow: hidden;
  }

  .projects-viewer > :global(*) {
    width: 100%;
    height: 100%;
  }

  .projects-viewer :global(canvas) {
    display: block;

    width: 100% !important;
    height: 100% !important;
  }
</style>