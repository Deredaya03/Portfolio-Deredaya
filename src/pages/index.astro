---
import Layout from '@layouts/Layout.astro';
import Viewer3D from '@components/Viewer3D.astro';
import Intro from '@components/Index/Intro.astro';
import CardProject from '@components/Index/cardProject.astro';
import PreFooter from '@components/Layout/PreFooter.astro';

import '@styles/intro.css';
import '@styles/project.css';

import { Data } from '@db/index.ts';

const {
  Intro: introSection,
  Projects: cardData,
} = Data;

const projects = Array.isArray(cardData)
  ? cardData
  : [];
---

<Layout title="Deredaya">
  <!-- Modelo 3D de fondo -->
  <div class="viewer-3d-container">
    <Viewer3D />
  </div>

  <main class="content-main">
    <div class="space"></div>

    <!-- Intro original -->
    <section class="intro">
      <Intro data={introSection} />

      <div class="card" data-tilt>
        <img
          src="/Profile.webp"
          alt="Profile Image"
          class="profile-image"
        />
      </div>
    </section>

    <!-- Zona sticky -->
    {
      projects.length > 0 && (
        <section
          class="project-main"
          data-project-section
        >
          <div
            class="sticky-screen"
            data-project-sticky
          >
            <!-- Fondo -->
            <div
              class="project-background"
              aria-hidden="true"
            >
              <div class="background-glow"></div>
              <div class="background-grid"></div>
            </div>

            <div class="sticky-layout">
              <!-- About -->
              <aside
                class="about-panel"
                id="about"
                data-about-panel
              >
                <span class="section-label">
                  Perfil
                </span>

                <h2 class="about-title">
                  Sobre mí
                </h2>

                <div class="about-content">
                  <p>
                    Programador Junior especializado en
                    <strong> Desarrollo Web</strong> y en la
                    creación de
                    <strong>
                      complementos y sistemas con VBA
                    </strong>.
                  </p>

                  <p>
                    Mi objetivo es crear una
                    <strong> empresa de confianza</strong>
                    para desarrollar sistemas computacionales
                    adaptados a las necesidades específicas de
                    cada empresa.
                  </p>

                  <p>
                    Actualmente estoy aprendiendo
                    <strong> TypeScript</strong> y
                    <strong> Tauri</strong> para llevar mis
                    sistemas a nuevas plataformas y mejorar su
                    rendimiento.
                  </p>

                  <p>
                    Busco simplificar y automatizar el trabajo,
                    haciendo que los procesos sean más rápidos,
                    cómodos y eficientes.
                  </p>
                </div>

                <div class="about-skills">
                  <span>Astro</span>
                  <span>JavaScript</span>
                  <span>TypeScript</span>
                  <span>VBA</span>
                  <span>CSS</span>
                </div>
              </aside>

              <!-- Proyectos -->
              <section
                class="projects-panel"
                id="projects"
              >
                <header
                  class="project-header"
                  data-project-header
                >
                  <div class="project-heading">
                    <span class="section-label">
                      Portafolio
                    </span>

                    <h2 class="project-title">
                      Proyectos
                    </h2>
                  </div>

                  <div
                    class="project-counter"
                    aria-label={`${projects.length} proyectos`}
                  >
                    <span data-project-current>
                      00
                    </span>

                    <span class="counter-line"></span>

                    <span>
                      {
                        String(
                          projects.length
                        ).padStart(2, '0')
                      }
                    </span>
                  </div>
                </header>

                <div
                  class="project-stage"
                  data-project-stage
                >
                  {
                    projects.map(
                      (project, index) => (
                        <article
                          class="project-slide"
                          data-project-slide
                          data-project-index={index}
                          aria-hidden="true"
                        >
                          <CardProject
                            card={project}
                            index={index}
                          />
                        </article>
                      )
                    )
                  }
                </div>

                <div
                  class="project-dots"
                  data-project-dots
                  aria-hidden="true"
                >
                  {
                    projects.map(() => (
                      <span
                        class="project-dot"
                        data-project-dot
                      ></span>
                    ))
                  }
                </div>
              </section>
            </div>

            <!-- Barra de progreso -->
            <div
              class="project-progress"
              data-project-progress-container
              aria-hidden="true"
            >
              <div
                class="project-progress-fill"
                data-project-progress
              ></div>
            </div>

            <!-- Estado inicial -->
            <div
              class="scroll-indicator"
              data-scroll-indicator
              aria-hidden="true"
            >
              <span class="scroll-indicator-label">
                Explora mis proyectos
              </span>

              <span class="scroll-arrow">
                ↓
              </span>

              <span class="scroll-text">
                Desliza
              </span>
            </div>
          </div>
        </section>
      )
    }
    <PreFooter />
  </main>

  <script src="@scripts/vanilla-tilt.js"></script>
  <script src="@scripts/intro.js"></script>

  <script>
    import '@scripts/projects-scroll.ts';
  </script>
</Layout>

<style>
  :root {
    color-scheme: dark;
  }

  .viewer-3d-container {
    position: fixed;
    inset: 0;
    z-index: 1;

    width: 100%;
    height: 100svh;

    pointer-events: none;
    overflow: hidden;
  }

  .viewer-3d-container > :global(*) {
    width: 100%;
    height: 100%;
  }

  .viewer-3d-container :global(canvas) {
    display: block;

    width: 100% !important;
    height: 100% !important;
  }

  .content-main {
    position: relative;
    z-index: 2;

    background: transparent;
  }

  .step {
    min-height: 100vh;
    pointer-events: auto;
  }
</style>