---
// src/pages/index.astro
import Layout from '@layouts/Layout.astro';
import Viewer3D from '@components/Viewer3D.astro';
import Intro from '@components/Index/Intro.astro';
import '@styles/intro.css';

import { Data } from '@db/index.ts'
const { Intro: introSection} = Data
---

<Layout title="Deredaya">
  <Viewer3D />

  <main class="content-main">
    <div class="space"/>
    <section class="intro">
      <Intro data={introSection} />
      <div class="card" data-tilt>
        <img src="/Profile.webp" alt="Profile Image" class="profile-image" />
      </div>
    </section>
    <section class="step"></section>
    <section class="step"></section>
  </main>
  <script src="@scripts/vanilla-tilt.js"></script> 
  
</script>

</Layout>

<style>
  :root {
    color-scheme: dark;
  }
  
  .step {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: auto;
  }
</style>
