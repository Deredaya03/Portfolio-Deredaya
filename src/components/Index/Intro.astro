---
import GlobeIcon from '@assets/Globe.astro';

const { data } = Astro.props; 
const { Global, Experience, Btns } = data;
---

<div class="intro-wrapper">
  <section class="intro-container scroll-fade">
    <div class="">
      <p class="title-top">{Global.Title}</p>
      <p class="subtitle">{Global.Subtitle}</p>
    </div>
    <div class="divider">
      <p class="title">{Global.Name}<br/>{Global.LastName}</p>
    </div>
    
    <p class="location"><GlobeIcon /> {Global.Location}</p>
    
    {
      Experience.map((exp:any) => (
        <article class="experience">
          <h3>{exp.Title}</h3>
          <div class="skils">
            {
              exp.Skills.map((skill:any) => (
                <p class="btn-item">{skill}</p>
              ))
            }
          </div>
        </article>
      ))
    }
  </section>

  <section class="buttons">
    {
      Btns.Tel.map((tel:any) => (
        <a href={tel.Href} class="btn tel">{tel.Text}</a>
      ))
    }
    { 
      Btns.Email.map((mail:any) => (
        <button id="btn-copiar" class="btn email" data-email={mail.Email}>
          {mail.Text}
        </button>
      ))
    }
  </section>
</div>

<script src="@scripts/intro.js"></script>