---
import '@styles/intro.css';
import GlobeIcon from '@assets/Globe.astro';
---

<div class="intro-wrapper">
  <section class="intro-container scroll-fade">
    <p class="title-top">Deredaya</p>
    <div class="divider">
      <p class="subtitle">Developer Frontend</p>
      <p class="title">Brandon Calderon</p>
    </div>
    <p class="location"><GlobeIcon /> Xalapa. Ver</p>

    <article class="experience">
      <h3>Experiencia</h3>
      <div class="skils">
        <p class="btn-item">Astro.Js</p>
        <p class="btn-item">Tailwind CSS</p>
        <p class="btn-item">JavaScript</p>
        <p class="btn-item">HTML</p>
        <p class="btn-item">CSS</p>
        <p class="btn-item">VBA</p>
        <p class="btn-item">Excel</p>
      </div>
    </article>
  </section>
  <section class="buttons">
    <a href="tel:+5644908381" class="btn tel">Contactame</a>
    <button id="btn-copiar" class="btn email">Copiar enlace</button>
  </section>
</div>


<script src="@scripts/intro.js"></script>
