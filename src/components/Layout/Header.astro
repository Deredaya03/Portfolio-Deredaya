---
import Logo from '@assets/Logo.astro';
import Github from '@assets/Github.astro';

import { Data } from '@db/index'
const { Header: headerData } = Data
const { NavItems } = headerData

const { pathname } = Astro.url;
---

<header class="header-container">
  <a class="logo" href="/" aria-label="Ir al inicio">
    <Logo class="icon"/>
    <Logo class="icon-bg"/>
  </a>
  <ul class="content">
    {
      NavItems.map((item) => {
        const isActive = pathname === item.Href || (item.Href !== '/' && pathname.startsWith(item.Href));

        return (
          <li class="link"><a href={item.Href} class={isActive ? 'active' : ''}>{item.Name}</a></li>
        )
      })
    }
  </ul>
  <section class="git-contact">
    <a href={headerData.link} target="_blank" rel="noopener noreferrer" class="logo">
      <Github class="icon"/>
    </a>
  </section>
</header>